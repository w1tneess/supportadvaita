{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supportadvaita",
  "compatibility_date": "2026-03-01",
  // Read by Cloudflare Workers Builds (`wrangler deploy` on master, `wrangler preview` on other branches).
  // The GitHub Actions Pages deploy ignores this file; Pages serves public/404.html for unknown paths.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Required (even empty) for `wrangler preview`, which Workers Builds runs for non-production branches
  "previews": {}
}
